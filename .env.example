# Pheonix local voice assistant. Copy this file to .env.
# The page gets these values from GET /voice/config on the local voice service. Nothing here is a secret.

# The name the assistant answers to. It is ignored when it appears in a command ("Pheonix, go to Paris").
ASSISTANT_NAME=Pheonix
# Your name for the greeting ("Good evening, Edison."). Leave empty to be addressed as ADDRESS_AS.
USER_NAME=
# How acknowledgments address you ("Certainly, sir.").
ADDRESS_AS=sir

# Wake phrase. "hey pheonix" has no pretrained openWakeWord model, so it is matched from local speech
# recognition. That works with natural speech but is a little less accurate than a trained model.
# Pretrained models exist for: hey jarvis, alexa, hey mycroft, hey rhasspy, timer, weather. Set WAKE_WORD to
# one of those for model based detection, or train your own and point WAKE_MODEL at the .onnx file.
# Leave it unset to use "hey" plus ASSISTANT_NAME.
WAKE_WORD=hey pheonix
# Optional: pretrained model name or path to a custom-trained .onnx (see docs/VOICE.md).
WAKE_MODEL=
# model = openWakeWord (accurate). transcript = match the phrase in short bursts of local speech recognition (less accurate).
# A phrase with no pretrained model switches to transcript on its own.
WAKE_MODE=model
# 0.05-0.99. Raise if it triggers by accident, lower if it misses you.
WAKE_THRESHOLD=0.5

# Kokoro British male voices: bm_george (default), bm_lewis, bm_daniel, bm_fable.
TTS_VOICE=bm_george
# whisper.cpp model: base.en (default, ~142 MB) or tiny.en (~75 MB, faster, less accurate).
STT_MODEL=base.en

# Seconds it keeps listening after each reply without needing the wake word.
FOLLOWUP_TIMEOUT_S=12
# Seconds it waits for you to start speaking after the wake word.
LISTEN_TIMEOUT_S=8
# Local voice service port. scripts/voice-service.sh binds it to 127.0.0.1 only.
# If you change it, update the /voice proxy target in vite.config.js to match.
VOICE_PORT=8791
